{
  "name": "Python Deep Learning Environment",
  "build":{
    "dockerfile": "../Dockerfile",
    "context": "..",
    "options":[
      "--tag=ad_project"
    ]
  },
  "runArgs": [
    "--ipc=host",
    "--gpus=all",
    "--rm"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "njpwerner.autodocstring"
      ]
    }
  },
  "forwardPorts": [8080]
}