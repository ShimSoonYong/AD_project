{
  "name": "Python Deep Learning Environment",
  "build":{
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--ipc=host",
    "--gpus=all",
    "--rm"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "njpwerner.autodocstring"
      ]
    }
  },
  "forwardPorts": [8080],
}